# ==============================================================================
# RentSense Control Tower — Environment Configuration Template
# Copy to .env for local/production deployment.
# NEVER commit real secrets or private values to source control.
# ==============================================================================

# Docker/Postgres runtime
POSTGRES_USER=rentsense_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rentsense_db

# Application environment
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# Seed only a fresh, empty disposable demo database; never refresh existing records.
SEED_DEMO_DATA=false
RUN_MIGRATIONS=true
# Azure HTTPS: set AUTH_COOKIE_SECURE=true. Local HTTP Compose defaults false.
# AUTH_COOKIE_SECURE=true

# Backend database and public URLs
# A production deploy should set DATABASE_URL to the PostgreSQL service name:
# postgresql+psycopg://rentsense_user:<password>@db:5432/rentsense_db
DATABASE_URL=postgresql+psycopg://rentsense_user:change-me@db:5432/rentsense_db
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000

# Browser-facing API base URL for the Next.js app.
# For the reverse-proxy setup, this is usually the public host (http://localhost)
# and not the internal backend service name.
NEXT_PUBLIC_API_URL=http://localhost
# Public Mapbox GL token. It is embedded at frontend build time; never use a secret (sk.*) token.
# Restrict the production token to the deployed HTTPS frontend origin in Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=

# In-process simulator (disabled by default; keep Azure at one backend replica)
TELEMETRY_SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_SECONDS=60
SIMULATOR_ACTIVE_VIEWERS_ONLY=true
SIMULATOR_IDLE_GRACE_SECONDS=60

# Operational thresholds
ALERT_DUE_SOON_HOURS=48
IDLE_HOURS_THRESHOLD=8.0
LOW_UTILIZATION_THRESHOLD=0.20

# Optional RBAC/auth mode
# Set AUTH_ENABLED=true to enable JWT authentication
AUTH_ENABLED=false

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED when AUTH_ENABLED=true. Never commit a real secret.
JWT_SECRET_KEY=change-me-generate-a-256-bit-random-hex-string
JWT_EXPIRE_MINUTES=480

# Admin user bootstrapped on first backend start (when AUTH_ENABLED=true)
# Change these before production deployment.
ADMIN_EMAIL=admin@rentsense.local
ADMIN_PASSWORD=change-me-use-a-strong-password

# ==============================================================================
# Email Notifications via Resend (https://resend.com)
# Dispatches real-time email alerts whenever a new fleet anomaly is detected.
# If RESEND_API_KEY or ALERT_NOTIFICATION_EMAIL_TO is blank, emails are safely disabled.
# ==============================================================================
# (Secret, optional) Resend API Key from your Resend dashboard (e.g., re_123456789)
RESEND_API_KEY=

# (Optional) Destination email address where fleet anomaly alerts should be delivered
# Note: For free/sandbox Resend accounts, this MUST be the verified account owner email
ALERT_NOTIFICATION_EMAIL_TO=

# (Optional) Sender display address. Defaults to Resend's free onboarding sandbox sender
ALERT_NOTIFICATION_EMAIL_FROM=RentSense Alerts <onboarding@resend.dev>

# (Optional) Minimum severity threshold to trigger emails: CRITICAL, HIGH, MEDIUM, LOW, INFO
# Defaults to MEDIUM (skips INFO/trivial signals, notifies on operational anomalies)
ALERT_NOTIFICATION_MIN_SEVERITY=MEDIUM

# ==============================================================================
# AI Operations Assistant via Google Gemini (https://aistudio.google.com)
# Grounded copilot providing real-time fleet Q&A and operational guidance.
# If GEMINI_API_KEY is blank, assistant returns a safe unconfigured status.
# ==============================================================================
# (Secret, optional) Google AI Studio API Key (e.g., AIzaSy...)
GEMINI_API_KEY=

# (Optional) Google Gemini Flash model identifier (defaults to gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# (Optional) Max multi-turn conversation context history to maintain (defaults to 6)
GEMINI_MAX_TURNS=6
